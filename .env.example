# Copy to ~/.techradar/.env
# Works with OpenRouter (cloud) or a local OpenAI-compatible server (llama.cpp, Ollama).

LLM_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash-lite
LLM_API_KEY=

# --- Discovery sweeps (front-row beyond your feeds) ---
# provider=llm (default) uses the LLM above; provider=mixedbread drives
# Mixedbread's TOAST-1 search agent and needs the key below.
DISCOVERY_PROVIDER=llm
MIXEDBREAD_API_KEY=

# --- Local transcription (optional) ---
# yt-dlp + faster-whisper ("uv pip install -e '.[transcribe]'"). Runs on GPU
# when available (CUDA), CPU otherwise.
WHISPER_MODEL=medium
